# Experimental: GeckoView Lite for Android 4.4 (API 19), 32-bit ARM.
# NOT YET BUILT. Every option below is one that exists in the esr115 tree
# (build/moz.configure/android-sdk.configure, mobile/android/moz.configure).
. "$topsrcdir/build/mozconfig.common"

ac_add_options --enable-project=mobile/android
ac_add_options --target=arm-linux-androideabi

# Lite mode lowers the default min SDK from 21 to 16 and drops Glean etc.
ac_add_options --enable-geckoview-lite
ac_add_options --with-android-min-sdk=19

ac_add_options --enable-optimize
ac_add_options --disable-debug
